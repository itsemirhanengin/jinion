{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/release", "!**/node_modules", "!**/.turbo", "!**/.next", "!**/.source", "!**/next-env.d.ts", "!**/fixtures", "!**/__snapshots__"]
  },
  // Lint only for now; formatting everything at once would rewrite most files.
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  // The docs site's CSS uses Tailwind's `@theme`.
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // `noUncheckedIndexedAccess` is on, and `!` marks the places where an index is known to exist.
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // Terminal escape sequences are what the input and output code matches.
        "noControlCharactersInRegex": "off",
        // Rows of static text in Ink often have nothing better to key by.
        "noArrayIndexKey": "off",
        // `${VAR}` is the syntax of .mcp.json files.
        "noTemplateCurlyInString": "off",
        // Callbacks that may return `false` to say they handled something, and nothing otherwise.
        "noConfusingVoidType": "off"
      },
      "correctness": {
        // Effects that run once on mount, and memos keyed by a value derived from their inputs, are deliberate here.
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "overrides": [
    {
      // The core draws nothing, so a desktop app can drive it too.
      "includes": ["packages/core/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Core draws nothing; React stays in the TUI.",
                  "ink": "Core draws nothing; Ink stays in the TUI.",
                  "jotai": "Import from jotai/vanilla: the root entry loads React.",
                  "jotai/utils": "Import from jotai/vanilla/utils: this entry loads React."
                },
                "patterns": [
                  { "group": ["@jinion/tui", "@jinion/tui/**"], "message": "Core has its own types and helpers; @jinion/tui is the TUI's." },
                  {
                    "group": ["**/app/**", "**/panels/**", "**/ui/**", "**/status/**"],
                    "message": "Core doesn't reach into the TUI's folders."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The terminal app is a client: what it needs of the core comes over the API, as for a desktop app or a phone.
      // `main.tsx` and `serve.ts` start the core, so they are the only files that build it.
      "includes": ["apps/cli/src/**", "!apps/cli/src/main.tsx", "!apps/cli/src/serve.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@jinion/core/prompt/files": {
                    "importNames": ["listProjectFiles"],
                    "message": "The app lists files through the API (files/list), as a client on another machine would."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@jinion/core/controllers/**",
                      "@jinion/core/state/**",
                      "@jinion/core/settings/**",
                      "@jinion/core/git/**",
                      "@jinion/core/memory/**",
                      "@jinion/core/mcp/**",
                      "@jinion/core/agent/claude/**",
                      "@jinion/core/agent/codex/**",
                      "@jinion/core/agent/demo/**",
                      "@jinion/core/conversation/store",
                      "@jinion/core/commands/builtin",
                      "@jinion/core/api/server",
                      "@jinion/core/api/connection",
                      "@jinion/core/api/methods/**"
                    ],
                    "message": "The app reaches the core through the API (useApi); its types come from @jinion/core/api/protocol."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The desktop app's renderer is a sandboxed page: of the core it takes types, the reducer and pure helpers, as
      // `JinionClient` does, never what runs the agent or touches the disk.
      "includes": ["apps/desktop/src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@jinion/core/controllers/**",
                      "@jinion/core/state/**",
                      "@jinion/core/settings/**",
                      "@jinion/core/git/**",
                      "@jinion/core/memory/**",
                      "@jinion/core/mcp/**",
                      "@jinion/core/prompt/**",
                      "@jinion/core/usage/**",
                      "@jinion/core/lib/**",
                      "@jinion/core/agent/claude/**",
                      "@jinion/core/agent/codex/**",
                      "@jinion/core/agent/demo/**",
                      "@jinion/core/conversation/store",
                      "@jinion/core/commands/**",
                      "@jinion/core/api/server",
                      "@jinion/core/api/connection",
                      "@jinion/core/api/methods/**",
                      "@jinion/core/api/websocket"
                    ],
                    "message": "The renderer runs in a sandboxed page; what it needs beyond types and the reducer comes over the API."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
