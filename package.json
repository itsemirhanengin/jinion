{
  "name": "jinion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @jinion/cli dev",
    "dev:docs": "pnpm --filter @jinion/docs dev",
    "start": "pnpm --filter @jinion/cli start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "biome check . && pnpm --filter @jinion/spacing check",
    "lint:fix": "biome check . --write && pnpm --filter @jinion/spacing fix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "turbo": "^2.11.6",
    "typescript": "^7.0.2"
  }
}
