{
  "name": "@jinion/desktop",
  "version": "0.0.1",
  "description": "Jinion's desktop app, in Electron",
  "license": "MIT",
  "homepage": "https://jinion.co",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.main.json && vite build",
