{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @jinion/docs build",
    "watchPatterns": ["/apps/docs/**", "/pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @jinion/docs start",
    "healthcheckPath": "/"
  }
}
