{
  "name": "@jinion/core",
  "version": "0.1.0",
  "description": "Jinion without a screen: the agent, conversations, settings, memory, git and MCP, for any client to drive",
  "license": "MIT",
  "homepage": "https://jinion.co",
  "type": "module",
  "exports": {
    "./testing/*": {
      "development": "./tests/support/*.ts"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture": "tsx --tsconfig ../../tsconfig.json scripts/fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "jotai": "^3.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
