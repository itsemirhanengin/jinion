{
  "name": "@jinion/tui",
  "version": "0.1.0",
  "description": "Terminal UI framework for Jinion, built on Ink and React",
  "license": "MIT",
  "homepage": "https://jinion.co",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
